diff --git a/publish.sh b/publish.sh
index 8062bca..78723ba 100755
--- a/publish.sh
+++ b/publish.sh
@@ -1,8 +1,12 @@
 #!/bin/sh
 # Publish a release archive to the package index.
-# Usage: publish.sh TOKEN ARCHIVE
+# Usage: DEPLOY_TOKEN=... publish.sh ARCHIVE
 set -eu
+: "${DEPLOY_TOKEN:?DEPLOY_TOKEN must be set}"
 INDEX_URL=${INDEX_URL:-https://packages.example.invalid/upload}
-token=$1
-archive=$2
-curl --fail -sS -H "Authorization: Bearer $token" --data-binary @"$archive" "$INDEX_URL"
+archive=$1
+[ -f "$archive" ] || { echo "publish.sh: no such archive: $archive" >&2; exit 2; }
+
+# The header goes to curl on stdin (-H @-), so the token never shows up in ps.
+printf 'Authorization: Bearer %s\n' "$DEPLOY_TOKEN" |
+  curl --fail -sS -H @- --data-binary @"$archive" "$INDEX_URL"
diff --git a/tests/test_publish.sh b/tests/test_publish.sh
new file mode 100755
index 0000000..0941718
--- /dev/null
+++ b/tests/test_publish.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Runs publish.sh against a stub curl; no network. Exit 0 = pass.
+set -eu
+here=$(cd "$(dirname "$0")/.." && pwd)
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+cat > "$tmp/curl" <<'EOF'
+#!/bin/sh
+# stub: record stdin (headers) and the argument list
+cat > "$STUB_OUT.stdin"
+printf '%s\n' "$*" > "$STUB_OUT.args"
+EOF
+chmod +x "$tmp/curl"
+echo data > "$tmp/pkg.tgz"
+
+STUB_OUT="$tmp/out" PATH="$tmp:$PATH" DEPLOY_TOKEN=test-token-not-real \
+  sh "$here/publish.sh" "$tmp/pkg.tgz"
+
+grep -q 'Authorization: Bearer test-token-not-real' "$tmp/out.stdin"
+if grep -q test-token-not-real "$tmp/out.args"; then
+  echo "FAIL: token visible on the curl command line" >&2
+  exit 1
+fi
+if (unset DEPLOY_TOKEN; PATH="$tmp:$PATH" STUB_OUT="$tmp/out2" sh "$here/publish.sh" "$tmp/pkg.tgz") 2>/dev/null; then
+  echo "FAIL: ran without DEPLOY_TOKEN" >&2
+  exit 1
+fi
+echo "ok"
