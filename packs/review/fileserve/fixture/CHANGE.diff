@@ -3,7 +3,10 @@ import os
 
 
 def resolve(root, relpath):
-    """Absolute path of `relpath` inside `root`; refuses paths that escape it."""
-    if ".." in relpath.split("/"):
+    """Absolute path of `relpath` inside `root`; refuses paths that escape it,
+    including through symlinks or an absolute `relpath`."""
