# Loaded by action-shell around every agent shell action in this arm.
# The guarded call is an actual Bash# execution boundary, not prompt text.
# @effects (not @guard) because it also VOUCHES for commands the Command
# Atlas does not classify (e.g. rg, or a literal nested `sh -c`): @guard only
# narrows the cap and denies an atlas-unknown command outright regardless of
# the cap, which silently failed almost every sourced agent action here.
@effects("read,write,exec")
@require('test -f "$BASHY_EXPERIMENT_ACTION"')
agentic function experiment_action() {
    source "$BASHY_EXPERIMENT_ACTION"
}
agentic { experiment_action; }
