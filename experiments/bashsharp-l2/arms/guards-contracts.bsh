# Loaded by action-shell around every agent shell action in this arm.
# The guarded call is an actual Bash# execution boundary, not prompt text.
@guard(effects: "read,write,process_exec")
@require('test -f "$BASHY_EXPERIMENT_ACTION"')
@ensure('test -f "$BASHY_EXPERIMENT_ACTION"')
agentic function experiment_action() {
    source "$BASHY_EXPERIMENT_ACTION"
}
agentic { experiment_action; }
